{#
  page/about.html.twig — статическая страница «О проекте».
  Наследует base.html.twig (header + footer).
#}
{% extends 'base.html.twig' %}

{% block title %}About | Silicon Symfony Demo{% endblock %}

{% block body %}

    {% include 'layout/breadcrumb.html.twig' with { current: 'About' } %}

    <section class="container mt-4 pt-lg-2 pb-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <h1 class="mb-4">About</h1>

                <p class="lead text-muted mb-4">
                    Symfony + Silicon — учебная демо-страница без базы данных.
                </p>

                <p class="mb-4">
                    Nunc aliquet scelerisque pellentesque imperdiet tortor elit, dictum.
                    Tristique odio at dignissim viverra aliquet eleifend erat. Tellus, at arcu,
                    egestas praesent. Varius aliquet pharetra adipiscing tincidunt orci nec neque.
                </p>

                <p class="text-muted mb-4">
                    Проект использует Twig-шаблоны, маршруты Symfony и захардкоженный массив
                    постов в контроллере. За основу базового шаблона base.html.twig взята
                    страница Silicon blog-list-with-sidebar.html.
                </p>

                <a href="{{ path('app_home') }}" class="btn btn-primary rounded-pill">
                    <i class="bx bx-left-arrow-alt fs-5 lh-1 me-1"></i>
                    Back to blog
                </a>

            </div>
        </div>
    </section>

{% endblock %}
