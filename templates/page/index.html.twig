{#
  ============================================================================
  page/index.html.twig — PageIndex (главная страница блога)
  ============================================================================
  Минимум содержимого страницы: h1 + текст-рыба + title.
  Основной контент: список 10 последних записей блога (хардкод из контроллера
  PageController::index()) + сайдбар с поиском, категориями и тегами.

  Наследуется от base.html.twig, который даёт шапку + меню + футер.
  Структура страницы взята из Silicon/blog-list-with-sidebar.html.
  ============================================================================
#}
{% extends 'base.html.twig' %}

{# title вкладки браузера #}
{% block title %}Blog List with Sidebar | Silicon Symfony Demo{% endblock %}

{% block body %}

{# ===== Хлебные крошки (breadcrumb) ===== #}
<nav class="container mt-lg-4 pt-5" aria-label="breadcrumb">
    <ol class="breadcrumb mb-0 pt-5">
        <li class="breadcrumb-item">
            <a href="{{ path('app_home') }}"><i class="bx bx-home-alt fs-lg me-1"></i>Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Blog List with Sidebar</li>
    </ol>
</nav>

{# ===== Основная секция страницы ===== #}
<section class="container mt-4 mb-2 mb-md-4 mb-lg-5 pt-lg-2 pb-5">

    {# --- Минимальное содержимое страницы: h1 + текст-рыба --- #}
    <div class="mb-4 pb-1 pb-md-3">
        <h1 class="mb-2">Blog List with Sidebar</h1>
        <p class="text-muted mb-0">
            Nunc aliquet scelerisque pellentesque imperdiet tortor elit, dictum.
            Tristique odio at dignissim viverra aliquet eleifend erat.
        </p>
    </div>

    {# ===== Список постов + сайдбар (2 колонки) ===== #}
    <div class="row">

        {# -------------------------------------------------------------------
           Левая колонка — 10 последних постов из контроллера.
           Данные передаются в переменной `posts` (см. PageController::index).
           Каждый пост: title, content, category, badge, image (может быть null), date.
           ------------------------------------------------------------------- #}
        <div class="col-xl-9 col-lg-8">

            {% for post in posts %}

                {% if post.image %}
                    {# --- Карточка поста с обложкой (image + текст справа) --- #}
                    <article class="card border-0 bg-transparent me-xl-5 mb-4">
                        <div class="row g-0">
                            <div class="col-sm-5 bg-position-center bg-repeat-0 bg-size-cover rounded-3"
                                 style="background-image: url({{ asset('assets/img/blog/' ~ post.image) }}); min-height: 15rem;"></div>
                            <div class="col-sm-7">
                                <div class="card-body px-0 pt-sm-0 ps-sm-4 pb-0 pb-sm-4">
                                    <span class="badge fs-sm text-white {{ post.badge }} mb-3">{{ post.category }}</span>
                                    <h3 class="h4">
                                        <a href="#">{{ post.title }}</a>
                                    </h3>
                                    <p class="mb-3">{{ post.content }}</p>
                                    <div class="fs-sm text-muted">{{ post.date }}</div>
                                </div>
                            </div>
                        </div>
                    </article>
                {% else %}
                    {# --- Карточка поста без обложки (только текст) --- #}
                    <article class="card me-xl-5 mb-4">
                        <div class="card-body">
                            <span class="badge fs-sm text-white {{ post.badge }} mb-3">{{ post.category }}</span>
                            <h3 class="h4">
                                <a href="#">{{ post.title }}</a>
                            </h3>
                            <p class="mb-3">{{ post.content }}</p>
                            <div class="fs-sm text-muted">{{ post.date }}</div>
                        </div>
                    </article>
                {% endif %}

                {# Отступ между карточками #}
                <div class="pb-2 pb-lg-3"></div>

            {% endfor %}
        </div>

        {# -------------------------------------------------------------------
           Правая колонка — сайдбар: поиск, категории, теги.
           Содержимое статичное (не приходит из контроллера).
           ------------------------------------------------------------------- #}
        <aside class="col-xl-3 col-lg-4">

            {# Форма поиска по блогу #}
            <form class="input-group mb-4">
                <input type="text" placeholder="Search the blog..." class="form-control rounded pe-5">
                <i class="bx bx-search position-absolute top-50 end-0 translate-middle-y me-3 fs-lg zindex-5"></i>
            </form>

            {# Список категорий #}
            <div class="card card-body mb-4">
                <h3 class="h5">Categories</h3>
                <ul class="nav flex-column fs-sm">
                    <li class="nav-item mb-1"><a href="#" class="nav-link py-1 px-0">Digital</a></li>
                    <li class="nav-item mb-1"><a href="#" class="nav-link py-1 px-0">Business</a></li>
                    <li class="nav-item mb-1"><a href="#" class="nav-link py-1 px-0">Technology</a></li>
                    <li class="nav-item mb-1"><a href="#" class="nav-link py-1 px-0">Startups</a></li>
                </ul>
            </div>

            {# Облако тегов #}
            <div class="card card-body">
                <h3 class="h5 mb-3">Tags</h3>
                <a href="#" class="btn btn-outline-secondary btn-sm me-1 mb-1">#symfony</a>
                <a href="#" class="btn btn-outline-secondary btn-sm me-1 mb-1">#twig</a>
                <a href="#" class="btn btn-outline-secondary btn-sm me-1 mb-1">#silicon</a>
                <a href="#" class="btn btn-outline-secondary btn-sm me-1 mb-1">#bootstrap</a>
            </div>
        </aside>

    </div>
</section>

{% endblock %}
