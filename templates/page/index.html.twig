{% extends 'layout.html.twig' %}

{% block title %}Blog{% endblock %}

{% block main_content %}
    {% include 'layout/breadcrumb.html.twig' with { current: 'Blog' } %}
    {% include 'layout/page_header.html.twig' with {
        title: 'Blog',
        subtitle: 'Latest posts from the database.'
    } %}

    {% for post in posts %}
        {% include 'partial/post-card.html.twig' with { post: post } %}
    {% else %}
        <p class="text-muted">No posts yet.</p>
    {% endfor %}
{% endblock %}
