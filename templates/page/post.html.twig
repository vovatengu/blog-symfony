{% extends 'layout.html.twig' %}

{% block title %}{{ post.name }}{% endblock %}

{% block main_content %}
    {% include 'layout/breadcrumb.html.twig' with { current: post.name } %}

    <h1 class="mb-3">{{ post.name }}</h1>

    {% if post.cover %}
        <img src="{{ sonata_path(post.cover, 'reference') }}" alt="{{ post.name }}" class="img-fluid rounded mb-4">
    {% endif %}

    <div class="mb-4">{{ post.body | raw }}</div>

    {% include 'layout/flash_messages.html.twig' %}
{% endblock %}
