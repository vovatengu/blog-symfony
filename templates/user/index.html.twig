{#
  user/index.html.twig — список постов текущего пользователя.
  Наследует base.html.twig (header + footer).
#}
{% extends 'base.html.twig' %}

{% block title %}My posts{% endblock %}

{% block body %}

    {% include 'layout/breadcrumb.html.twig' with { current: 'My posts' } %}

    <section class="container mt-4 mb-2 mb-md-4 mb-lg-5 pt-lg-2 pb-5">

        {% include 'layout/page_header.html.twig' with { title: 'My posts' } %}

        <div class="row">
            <div class="col-xl-9 col-lg-8">
                {% for post in posts %}
                    {% include 'layout/post_card.html.twig' with { post: post, editable: true } %}
                {% else %}
                    <p class="text-muted">Постов пока нет.</p>
                {% endfor %}
            </div>

            {% include 'layout/blog_sidebar.html.twig' %}
        </div>
    </section>

{% endblock %}
