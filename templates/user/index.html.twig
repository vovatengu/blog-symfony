{% extends 'layout.html.twig' %}

{% block title %}My posts{% endblock %}

{% block main_content %}
    {% include 'layout/breadcrumb.html.twig' with { current: 'My posts' } %}
    {% include 'layout/page_header.html.twig' with { title: 'My posts' } %}

    {% for post in posts %}
        {% include 'partial/post-card.html.twig' with { post: post, editable: true } %}
    {% else %}
        <p class="text-muted">No posts yet.</p>
    {% endfor %}
{% endblock %}
