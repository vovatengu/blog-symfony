<div class="card mb-4">
    <div class="card-body">
        <h3 class="h6 mb-3">Categories</h3>
        <ul class="nav flex-column small">
            {% for category in this.categories %}
                <li class="nav-item">
                    <a href={{ path('app_category', {slug: category.slug}) }} class="nav-link px-0 py-1">{{ category.name }}</a>
                </li>
            {% else %}
                <li class="text-muted">No categories yet.</li>
            {% endfor %}
        </ul>
    </div>
</div>
