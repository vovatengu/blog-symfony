<header class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
    <div class="container">
        <a href="{{ path('app_home') }}" class="navbar-brand">Symfony Blog</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a href="{{ path('app_home') }}" class="nav-link">Blog</a>
                </li>
                <li class="nav-item">
                    <a href="{{ path('app_about') }}" class="nav-link">About</a>
                </li>
            </ul>
            <ul class="navbar-nav ms-auto">
                {% if app.user %}
                    <li class="nav-item">
                        <span class="nav-link">Hello, {{ app.user.username }}!</span>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_post_new') }}" class="nav-link">New Post</a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_user_index') }}" class="nav-link">My Posts</a>
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('app_logout') }}" class="nav-link">Logout</a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a href="{{ path('app_login') }}" class="nav-link">Login</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</header>
